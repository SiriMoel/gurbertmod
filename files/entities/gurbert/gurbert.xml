	<!-- in world behaviour -->

	<LuaComponent
		_tags="enabled_in_world"
		script_source_file="mods/gurbertmod/files/entities/gurbert/behaviour.lua"
		execute_every_n_frame="4"
	></LuaComponent>

	<_Transform 
		rotation="0" 
		scale.x="1" 
		scale.y="1" >
