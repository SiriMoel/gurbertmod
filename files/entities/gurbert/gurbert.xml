		max_child_items="0"
		play_spinning_animation="0"
		is_pickable="1"
		is_equipable_forced="1"
		ui_sprite="mods/gurbertmod/files/entities/gurbert/sprites/sprite_ui.png"
		preferred_inventory="QUICK"
		item_name="Gurbert"
		ui_description="NYI"
	></ItemComponent> <!-- custom_pickup_string="Press $0 to gurbert $1" -->

	<AbilityComponent
		ui_name="Gurbert"
		throw_as_item="1"
