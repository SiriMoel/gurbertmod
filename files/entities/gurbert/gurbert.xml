	<SimplePhysicsComponent
		_tags="enabled_in_world"
	></SimplePhysicsComponent>

	<SpriteAnimatorComponent
		_tags="enabled_in_world"
	></SpriteAnimatorComponent>

	<SpriteComponent 
        _tags="character,frog_big,enabled_in_world"
		image_file="data/enemies_gfx/frog_big.xml" 
		rect_animation="stand"
		offset_x="0"
		offset_y="0"
		z_index="1.2"
		>
	</SpriteComponent>

	<VelocityComponent
		_tags="enabled_in_world"
		updates_velocity="1" 
		gravity_y="400"
		mass="0.05"
		air_friction="0.55"
		>
	</VelocityComponent>

	<HitboxComponent 
